{
  "name": "desk",
  "version": "0.2.7",
  "description": "TNotes Desk — multi knowledge-base desktop client",
  "main": "./out/main/index.js",
  "author": "tnotesjs",
  "homepage": "https://github.com/tnotesjs/desk",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "vitest run",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win --publish never",
    "build:mac": "pnpm run build && electron-builder --mac --publish never",
    "build:linux": "pnpm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@milkdown/crepe": "7.22.1",
    "@milkdown/kit": "7.22.1",
    "@tnotesjs/core": "0.8.0",
    "@tnotesjs/mindmap-core": "^0.2.2",
    "@tnotesjs/ui": "^0.1.1",
    "@types/markdown-it": "^14.2.0",
    "@uiw/codemirror-theme-github": "4.25.11",
    "dompurify": "^3.4.14",
    "github-slugger": "^2.0.0",
    "katex": "^0.18.4",
    "markdown-it": "^15.0.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.17.0",
    "minisearch": "^7.2.0",
    "pinia": "^4.0.3",
    "prettier": "^3.9.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.11",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "happy-dom": "^20.11.6",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.11",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  }
}
